<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- ============================================================ -->
    <!--  Nordic Light Color Palette                                  -->
    <!--  Inspired by Nord (nordtheme.com): Polar Night → Snow Storm  -->
    <!-- ============================================================ -->

    <!-- Base backgrounds (Snow Storm) -->
    <Color x:Key="RegionColor">#EBEEF5</Color>
    <Color x:Key="SecondaryRegionColor">#E0E4EB</Color>
    <Color x:Key="ThirdlyRegionColor">#ECEFF4</Color>
    <Color x:Key="BackgroundColor">#D8DEE9</Color>

    <!-- Text colors (Polar Night) -->
    <Color x:Key="PrimaryTextColor">#2E3440</Color>
    <Color x:Key="SecondaryTextColor">#4C566A</Color>
    <Color x:Key="ThirdlyTextColor">#7B88A1</Color>
    <Color x:Key="ReverseTextColor">#ECEFF4</Color>
    <Color x:Key="TextIconColor">#2E3440</Color>

    <!-- Title colors (Frost blue accent, not general text) -->
    <Color x:Key="TitleColor">#5E81AC</Color>
    <Color x:Key="SecondaryTitleColor">#5E81AC</Color>

    <!-- Primary accent (Frost 1) -->
    <Color x:Key="PrimaryColor">#E8EFF8</Color>
    <Color x:Key="PrimaryBrushColor">#5E81AC</Color>
    <Color x:Key="PrimaryMouseOverColor">#4C6B97</Color>
    <Color x:Key="LightPrimaryColor">#EBEEF5</Color>
    <Color x:Key="DarkPrimaryColor">#4C6B97</Color>

    <!-- Danger (Aurora Red) -->
    <Color x:Key="DangerColor">#F5E6E8</Color>
    <Color x:Key="DangerBrushColor">#BF616A</Color>
    <Color x:Key="DangerMouseOverColor">#A54A53</Color>
    <Color x:Key="LightDangerColor">#F5E6E8</Color>
    <Color x:Key="DarkDangerColor">#A54A53</Color>

    <!-- Warning (Aurora Yellow) -->
    <Color x:Key="WarningColor">#F5EFE0</Color>
    <Color x:Key="WarningBrushColor">#EBCB8B</Color>
    <Color x:Key="WarningMouseOverColor">#D4B56E</Color>
    <Color x:Key="LightWarningColor">#F5EFE0</Color>
    <Color x:Key="DarkWarningColor">#D4B56E</Color>

    <!-- Info (Frost 2) -->
    <Color x:Key="InfoColor">#E4EFF6</Color>
    <Color x:Key="InfoBrushColor">#81A1C1</Color>
    <Color x:Key="InfoMouseOverColor">#6A8BAD</Color>
    <Color x:Key="LightInfoColor">#E4EFF6</Color>
    <Color x:Key="DarkInfoColor">#6A8BAD</Color>

    <!-- Success (Aurora Green) -->
    <Color x:Key="SuccessColor">#E8F0E4</Color>
    <Color x:Key="SuccessBrushColor">#A3BE8C</Color>
    <Color x:Key="SuccessMouseOverColor">#8DA976</Color>
    <Color x:Key="LightSuccessColor">#E8F0E4</Color>
    <Color x:Key="DarkSuccessColor">#8DA976</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#C8CED9</Color>
    <Color x:Key="SecondaryBorderColor">#7B88A1</Color>

    <!-- Default / neutral -->
    <Color x:Key="DefaultColor">#E5E9F0</Color>
    <Color x:Key="DarkDefaultColor">#D0D5DE</Color>

    <!-- Accent (Aurora Orange) -->
    <Color x:Key="AccentColor">#D08770</Color>
    <Color x:Key="DarkAccentColor">#B8705A</Color>

    <!-- Disabled -->
    <Color x:Key="DisableColor">#D8DEE9</Color>

    <!-- Mask / overlay -->
    <Color x:Key="DarkMaskColor">#20000000</Color>
    <Color x:Key="LightMaskColor">#40000000</Color>
    <Color x:Key="OverlayColor">#99FFFFFF</Color>

    <!-- ============================================================ -->
    <!--  Override HandyControl Brushes for Nordic Light              -->
    <!--  These are derived from the Color resources above, but       -->
    <!--  we also override them explicitly to ensure consistency.     -->
    <!-- ============================================================ -->

    <!-- Region / background brushes -->
    <SolidColorBrush x:Key="RegionBrush" Color="#EBEEF5"/>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#E0E4EB"/>
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#D8DEE9"/>
    <SolidColorBrush x:Key="PrimaryRegionBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="DarkRegionBrush" Color="#D8DEE9"/>

    <!-- Text brushes - THIS IS THE KEY: these are what HC controls use internally -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#2E3440"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#7B88A1"/>
    <SolidColorBrush x:Key="ReverseTextBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextIconBrush" Color="#2E3440"/>

    <!-- Title brushes (accent color for headings, not general text) -->
    <SolidColorBrush x:Key="TitleBrush" Color="#5E81AC"/>
    <SolidColorBrush x:Key="SecondaryTitleBrush" Color="#5E81AC"/>
    <SolidColorBrush x:Key="ThirdlyTitleBrush" Color="#7B88A1"/>

    <!-- Border brushes -->
    <SolidColorBrush x:Key="BorderBrush" Color="#C8CED9"/>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#7B88A1"/>

    <!-- Primary brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#5E81AC"/>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#4C6B97"/>

    <!-- Semantic brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#A3BE8C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#EBCB8B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#BF616A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#81A1C1"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#B48EAD"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#D08770"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#D08770"/>

    <!-- Light semantic (backgrounds for tags/badges) -->
    <SolidColorBrush x:Key="LightSuccessBrush" Color="#E8F0E4"/>
    <SolidColorBrush x:Key="LightWarningBrush" Color="#F5EFE0"/>
    <SolidColorBrush x:Key="LightDangerBrush" Color="#F5E6E8"/>
    <SolidColorBrush x:Key="LightInfoBrush" Color="#E4EFF6"/>
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="#E8EFF8"/>

    <!-- Dark semantic -->
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="#8DA976"/>
    <SolidColorBrush x:Key="DarkWarningBrush" Color="#D4B56E"/>
    <SolidColorBrush x:Key="DarkDangerBrush" Color="#A54A53"/>
    <SolidColorBrush x:Key="DarkInfoBrush" Color="#6A8BAD"/>

    <!-- Default / neutral -->
    <SolidColorBrush x:Key="DefaultBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="DarkDefaultBrush" Color="#D0D5DE"/>

    <!-- Mask -->
    <SolidColorBrush x:Key="DarkMaskBrush" Color="#20000000"/>
    <SolidColorBrush x:Key="DarkOpacityBrush" Color="#40000000"/>

    <!-- ============================================================ -->
    <!--  App-specific Styles                                         -->
    <!-- ============================================================ -->

    <!-- Small icon button for tree operations -->
    <Style x:Key="TreeIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Code Editor TextBox -->
    <Style x:Key="CodeEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- Field context menu style (for AddFieldButton_Click) -->
    <Style x:Key="FieldContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PrimaryRegionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

</ResourceDictionary>
