<Window x:Class="GrpcInvokeTool.StressTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GrpcInvokeTool.ViewModels"
        xmlns:models="clr-namespace:GrpcInvokeTool.Models"
        xmlns:converters="clr-namespace:GrpcInvokeTool.Converters"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Stress Test - gRPC Invoke Tool"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:IntToVisibilityConverter x:Key="IntToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <Border Grid.Column="0" Background="{DynamicResource PrimaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab Control -->
                <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTab}"
                            Margin="4" Background="Transparent" BorderThickness="0"
                            x:Name="NavTabs">
                    <TabItem Header="Groups"/>
                    <TabItem Header="Plans"/>
                    <TabItem Header="Reports"/>
                </TabControl>

                <!-- Groups Panel -->
                <Grid Grid.Row="1" x:Name="GroupsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="+ Group" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding CreateGroupCommand}" Padding="12,0" Margin="4,4,4,4"/>
                    <ListView Grid.Row="1" x:Name="GroupsList" ItemsSource="{Binding Groups}" 
                              SelectedItem="{Binding SelectedGroup}" Margin="4" Background="Transparent" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Calls" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Calls.Count}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- Plans Panel -->
                <Grid Grid.Row="1" x:Name="PlansPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="+ Plan" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding CreatePlanCommand}" Padding="12,0" Margin="4,4,4,4"/>
                    <ListView Grid.Row="1" x:Name="PlansList" ItemsSource="{Binding Plans}" 
                              SelectedItem="{Binding SelectedPlan}" Margin="4" Background="Transparent" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Steps" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Steps.Count}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- Reports Panel -->
                <Grid Grid.Row="1" x:Name="ReportsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Reports" FontSize="14" FontWeight="SemiBold" Margin="8,8,8,4"/>
                    <ListView Grid.Row="1" x:Name="ReportsList" ItemsSource="{Binding Reports}" 
                              SelectedItem="{Binding SelectedReport}" Margin="4" Background="Transparent" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PlanName}" FontWeight="Medium"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Duration" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DurationDisplay}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Rate" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SuccessRateDisplay}" Foreground="{DynamicResource SuccessBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Panel -->
        <Grid Grid.Column="1">
            <!-- Group Detail -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="GroupDetailPanel" Visibility="Collapsed">
                <StackPanel Margin="16">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <hc:TextBox Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="18" FontWeight="SemiBold" Style="{StaticResource TextBoxExtend}"
                                        Margin="0,0,0,4" TextChanged="GroupName_TextChanged"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,12,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} call(s)">
                                            <Binding Path="SelectedGroup.Calls.Count" Mode="OneWay"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <CheckBox Content="Parallel" IsChecked="{Binding SelectedGroup.IsParallel}"
                                          Checked="ParallelCheckBox_Changed" Unchecked="ParallelCheckBox_Changed" Margin="0,0,8,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Delete" Style="{StaticResource ButtonDanger}"
                                    Command="{Binding DeleteGroupCommand}" Padding="12,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Interface Calls" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ListView ItemsSource="{Binding SelectedGroup.Calls}" 
                              Background="{DynamicResource PrimaryRegionBrush}"
                              BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                              MinHeight="200" MaxHeight="400"
                              MouseDoubleClick="CallsList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Type" Width="45">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MethodTypeTag}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Method" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Server" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ServerAddress}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="&#x25B2;" Padding="4,0" Margin="0,0,2,0"
                                                        Style="{StaticResource ButtonDefault}"
                                                        Click="MoveCallUp_Click" Tag="{Binding}"/>
                                                <Button Content="&#x25BC;" Padding="4,0" Margin="0,0,2,0"
                                                        Style="{StaticResource ButtonDefault}"
                                                        Click="MoveCallDown_Click" Tag="{Binding}"/>
                                                <Button Content="x" Padding="4,0"
                                                        Style="{StaticResource ButtonDanger}"
                                                        Click="RemoveCall_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="&#x25B6; Execute Group" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding ExecuteGroupCommand}" Padding="16,0" />
                        <Button Content="&#x23F9; Cancel" Style="{StaticResource ButtonDanger}"
                                Command="{Binding CancelExecutionCommand}" Margin="8,0,0,0" Padding="12,0"
                                Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Plan Detail -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="PlanDetailPanel" Visibility="Collapsed">
                <StackPanel Margin="16">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <hc:TextBox Text="{Binding SelectedPlan.Name, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="18" FontWeight="SemiBold" Style="{StaticResource TextBoxExtend}"
                                        Margin="0,0,0,4" TextChanged="PlanName_TextChanged"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Loop" IsChecked="{Binding SelectedPlan.IsLoopEnabled}" Margin="0,0,8,0"/>
                                <hc:NumericUpDown Value="{Binding SelectedPlan.LoopCount}" Minimum="0" Maximum="100000"
                                                   Width="100" Margin="0,0,8,0"
                                                   Visibility="{Binding SelectedPlan.IsLoopEnabled, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="(0=infinite)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding SelectedPlan.IsLoopEnabled, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Delete" Style="{StaticResource ButtonDanger}"
                                    Command="{Binding DeletePlanCommand}" Padding="12,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Steps" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ListView ItemsSource="{Binding SelectedPlan.Steps}"
                              Background="{DynamicResource PrimaryRegionBrush}"
                              BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                              MinHeight="150" MaxHeight="350">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Group" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValue="{Binding GroupId}" SelectedValuePath="Id"
                                                      DisplayMemberPath="Name" Width="180" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Interval" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="Random" IsChecked="{Binding IsRandomInterval}" Margin="0,0,4,0"/>
                                                <hc:NumericUpDown Value="{Binding IntervalMs}" Minimum="0" Maximum="60000"
                                                                   Width="80"
                                                                   Visibility="{Binding IsRandomInterval, Converter={StaticResource InverseBoolToVis}}"/>
                                                <TextBlock Text="ms" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"
                                                           Visibility="{Binding IsRandomInterval, Converter={StaticResource InverseBoolToVis}}"/>
                                                <hc:NumericUpDown Value="{Binding MinIntervalMs}" Minimum="0" Maximum="60000"
                                                                   Width="70"
                                                                   Visibility="{Binding IsRandomInterval, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="-" FontSize="11" VerticalAlignment="Center" Margin="2,0,2,0"
                                                           Visibility="{Binding IsRandomInterval, Converter={StaticResource BoolToVis}}"/>
                                                <hc:NumericUpDown Value="{Binding MaxIntervalMs}" Minimum="0" Maximum="60000"
                                                                   Width="70"
                                                                   Visibility="{Binding IsRandomInterval, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="&#x25B2;" Padding="4,0" Margin="0,0,2,0"
                                                        Style="{StaticResource ButtonDefault}"
                                                        Click="MoveStepUp_Click" Tag="{Binding}"/>
                                                <Button Content="&#x25BC;" Padding="4,0" Margin="0,0,2,0"
                                                        Style="{StaticResource ButtonDefault}"
                                                        Click="MoveStepDown_Click" Tag="{Binding}"/>
                                                <Button Content="x" Padding="4,0"
                                                        Style="{StaticResource ButtonDanger}"
                                                        Click="RemoveStep_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="+ Add Step" Style="{StaticResource ButtonDefault}"
                                Command="{Binding AddStepToPlanCommand}" Padding="12,0" Margin="0,0,16,0"/>
                        <Button Content="Save" Style="{StaticResource ButtonDefault}"
                                Command="{Binding SavePlanCommand}" Padding="12,0" Margin="0,0,8,0"/>
                        <Button Content="&#x25B6; Execute Plan" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding ExecutePlanCommand}" Padding="16,0" />
                        <Button Content="&#x23F9; Cancel" Style="{StaticResource ButtonDanger}"
                                Command="{Binding CancelExecutionCommand}" Margin="8,0,0,0" Padding="12,0"
                                Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ExecutionStatus}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Report Detail -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ReportDetailPanel" Visibility="Collapsed">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding SelectedReport.PlanName}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                    <!-- Summary Cards -->
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Background="{DynamicResource PrimaryRegionBrush}" CornerRadius="6" Margin="0,0,8,0" Padding="12,0">
                            <StackPanel>
                                <TextBlock Text="Total" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedReport.TotalRequests}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PrimaryRegionBrush}" CornerRadius="6" Margin="0,0,8,0" Padding="12,0">
                            <StackPanel>
                                <TextBlock Text="Success Rate" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedReport.SuccessRateDisplay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PrimaryRegionBrush}" CornerRadius="6" Margin="0,0,8,0" Padding="12,0">
                            <StackPanel>
                                <TextBlock Text="Avg (ms)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedReport.AvgResponseMs, StringFormat=F1}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PrimaryRegionBrush}" CornerRadius="6" Padding="12,0">
                            <StackPanel>
                                <TextBlock Text="RPS" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedReport.RpsDisplay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Statistics Row -->
                    <Border Background="{DynamicResource PrimaryRegionBrush}" CornerRadius="6" Padding="12,0" Margin="0,0,0,12">
                        <UniformGrid Columns="5">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Min" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedReport.MinResponseMs, StringFormat=F1}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Avg" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedReport.AvgResponseMs, StringFormat=F1}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Max" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedReport.MaxResponseMs, StringFormat=F1}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="P99" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedReport.P99ResponseMs, StringFormat=F1}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Duration" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedReport.DurationDisplay}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Detail Results -->
                    <TextBlock Text="Call Details" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ListView ItemsSource="{Binding SelectedReport.CallResults}"
                              Background="{DynamicResource PrimaryRegionBrush}"
                              BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                              MaxHeight="350"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              MouseDoubleClick="CallResults_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Index}" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Step" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StepName}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Method" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MethodDisplay}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Duration" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DurationDisplay}" Foreground="{DynamicResource WarningBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" 
                                                       Foreground="{Binding IsSuccess, Converter={StaticResource StatusToColor}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Summary" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Summary}" 
                                                       Foreground="{Binding IsSuccess, Converter={StaticResource StatusToColor}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="11"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Button Content="Delete Report" Style="{StaticResource ButtonDanger}"
                            Command="{Binding DeleteReportCommand}" Padding="12,0" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Select an item from the left panel" FontSize="16"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>