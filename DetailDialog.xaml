<Window x:Class="GrpcInvokeTool.DetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Details"
        Width="600" Height="500"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        KeyDown="Window_KeyDown">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
        
        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Info Section -->
                <Border Background="{DynamicResource PrimaryRegionBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <ContentControl Content="{Binding InfoContent}"/>
                </Border>
                
                <!-- JSON Section -->
                <TextBlock Text="Message Details" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource PrimaryRegionBrush}" CornerRadius="6" Padding="12">
                    <TextBox Text="{Binding JsonContent, Mode=OneWay}" 
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="300"
                             FontFamily="Consolas, Monaco, monospace"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Close Button -->
        <Button Grid.Row="2" Content="Close" Style="{StaticResource ButtonPrimary}"
                Click="Close_Click" Padding="24,0" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>